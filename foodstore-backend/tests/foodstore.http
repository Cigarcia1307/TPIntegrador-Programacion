@baseUrl = http://127.0.0.1:8000/api/v1

### 1. Login administrador - 200
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=admin&password=Admin1234!

### 2. Consultar sesion actual - 200
GET {{baseUrl}}/auth/me

### 3. Listar categorias - 200
GET {{baseUrl}}/categorias

### 4. Listar productos - 200
GET {{baseUrl}}/productos?skip=0&limit=20

### 5. Buscar productos - 200
GET {{baseUrl}}/productos?search=arroz

### 6. Consultar stock inicial - 200
GET {{baseUrl}}/productos/1

### 7. Consultar usuarios como administrador - 200
GET {{baseUrl}}/admin/usuarios

### 8. Consultar resumen administrativo - 200
GET {{baseUrl}}/pedidos/resumen

### 9. Cerrar sesion - 200
POST {{baseUrl}}/auth/logout

### 10. Login cliente - 200
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=cliente&password=Cliente1234!

### 11. Consultar sesion del cliente - 200
GET {{baseUrl}}/auth/me

### 12. Crear pedido - 201
# @name crearPedido
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "items": [
    {
      "producto_id": 1,
      "cantidad": 2
    }
  ],
  "forma_pago": "EFECTIVO",
  "direccion_entrega": "Av. San Martin 123",
  "notas": "Pedido de prueba TPI"
}

### 13. Consultar stock descontado - 200
GET {{baseUrl}}/productos/1

### 14. Listar mis pedidos - 200
GET {{baseUrl}}/pedidos

### 15. Consultar detalle del pedido - 200
GET {{baseUrl}}/pedidos/{{crearPedido.response.body.$.id}}

### 16. Cancelar pedido - 200
PATCH {{baseUrl}}/pedidos/{{crearPedido.response.body.$.id}}/cancelar

### 17. Verificar restitucion de stock - 200
GET {{baseUrl}}/productos/1

### 18. Intentar acceder como administrador - 403
GET {{baseUrl}}/admin/usuarios

### 19. Cerrar sesion - 200
POST {{baseUrl}}/auth/logout

### 20. Consultar sesion sin autenticacion - 401
GET {{baseUrl}}/auth/me